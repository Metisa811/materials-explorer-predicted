 اساس M باید گزارش شود و Random 5-fold به‌تنهایی کافی نیست.**\n","metadata":{}},{"id":"6cae8cf9-3f17-448c-98dd-085b20374e1a","cell_type":"code","source":"","metadata":{"trusted":true},"outputs":[],"execution_count":null}]}